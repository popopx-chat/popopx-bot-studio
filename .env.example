# POPOPX Bot Studio — 配置样例（复制为 .env 后填写，切勿把真实令牌提交到 git）
#
#   cp .env.example .env && chmod 600 .env
#
# ⚠️  .env 必须 chmod 600（属主 rw，其它人零权限）。app/config.py 的
#     Settings.security_warnings() 会检查 .env、studio.state.json、studio.key，
#     发现 0640/0644 之类更宽的权限时打印明确的安全警告；安装脚本也会复检。
#     生成方式：install_ubuntu22.sh / install_macos.sh / start_macos.sh 会自动写入
#     一个随机 STUDIO_ADMIN_TOKEN（已存在的 .env 永不被静默覆盖）。
#
# 变量名与默认值全部对齐 studio/app/config.py（load_settings / _int_env），
# 未列出的键会被 parse_env_text 解析但不会被读取。

# ── 网络：严格回环隔离 ──────────────────────────────────────────────────────
# 监听地址。默认且推荐 127.0.0.1；填非回环地址时，若未同时设置
# STUDIO_ALLOW_LAN=1，config.py 会直接抛 ConfigError 拒绝启动。
STUDIO_HOST=127.0.0.1

# 管理后台 / Open API 监听端口（1-65535，默认 8090）。
STUDIO_PORT=8090

# 唯一显式的「允许非回环」开关。取值 1/true/yes/on 才生效。
# Studio 自带 token 门禁但没有 TLS 与多用户模型：除非你自己加上反向代理与
# 防火墙，否则请保持 0。install_macos.sh 只在传入 --lan 时才会写 1。
STUDIO_ALLOW_LAN=0

# ── 鉴权 ────────────────────────────────────────────────────────────────────
# 管理后台与 /api/admin/* 的令牌（X-Studio-Token 或 Authorization: Bearer）。
# 留空 = 所有管理路由返回 401（fail-closed），并在启动时打印警告。
# 生成：python3 -c 'import secrets;print(secrets.token_hex(32))'
STUDIO_ADMIN_TOKEN=replace-me-with-locally-generated-random-token

# ── 状态与数据目录 ──────────────────────────────────────────────────────────
# 数据根目录：SQLite 账本 studio.db（WAL）、studio.state.json、studio.key、
# backups/，以及每 Bot 隔离目录 <data_dir>/bots/<bot_id>/cli-data。
# 默认 <repo>/var/studio，目录权限应为 0700。
STUDIO_DATA_DIR=

# 显式指定 .env 路径（默认从 studio/app 向上查找仓库根的 .env，其次 cwd）。
STUDIO_ENV_FILE=

# ── popopx-cli 二进制（零二进制捆绑：仓库内不含任何编译产物）────────────────
# Studio 只通过 ws://127.0.0.1:<port> 控制外部进程，二进制由安装脚本按需下载。
# 解析顺序：CLI_BIN_PATH → PATH 中的 popopx-cli → /usr/local/bin/popopx-cli。
CLI_BIN_PATH=/usr/local/bin/popopx-cli

# ── Bot 控制端口段（严禁 0.0.0.0，每 Bot 独立端口 + 独立 cli-data）───────────
# 分配从 BOT_WS_PORT_BASE 递增，超过 BOT_WS_PORT_MAX 即报「端口耗尽」。
BOT_WS_PORT_BASE=5230
BOT_WS_PORT_MAX=5299

# ── SMP 集群（可选覆写）─────────────────────────────────────────────────────
# 留空 = 继承 popopx-cli 内置的双栈 smp1..8.popopx.im 集群（安装脚本不会
# 硬编码另一套集群）。仅当你确实要换自建 SMP 中继时再填，空格或逗号分隔；
# 它会作为单个 argv token 传给 --server，由 #!/bin/sh 包装脚本逐 token 加引号，
# 从而免疫 systemd/launchd 的剥引号拆词。
BOT_SMP_SERVERS=

# ── 界面语言 ────────────────────────────────────────────────────────────────
# 管理后台默认语种，缺省 en；不在 18 语种支持列表内时回退并告警。
# 例如：zh-Hans、zh-Hant、en、ja、ko、ru、es、fr、de、pt-BR …
STUDIO_LOCALE=zh-Hans

# ── 替身机器人：Needle 3 小引擎（意图路由）────────────────────────────────────
# 总开关。置 0 时消息管线完全退回原有规则/插件链路，替身逻辑不介入。
AGENT_ENABLED=1

# 内置权重目录。默认 studio/assets/models（随仓库内置，运行期绝不联网下载）；
# 只有在你把权重搬到别处时才覆写。
# 加载前 app/needle_assets.py 会按 needle3.manifest.json 复核字节数与 SHA-256，
# 复核命令：python3 official_tools/verify_needle_assets.py
NEEDLE3_ASSET_DIR=

# 单次意图抽取的时间上限（0.05–120 秒，默认 2.0）。超时即降级到规则回退，
# 不会因为端侧模型卡住而拖垮整条消息管线。
NEEDLE3_TIMEOUT_SECONDS=2.0

# ── 替身机器人：大引擎（话术生成，可选）───────────────────────────────────────
# 默认关闭。开启后由 OpenAI 兼容接口改写最终话术；关闭或小引擎失败时
# 使用模板文案，功能不缺失，只是没那么像人。
REASONER_ENABLED=0

# 本地 Ollama 请写 http://127.0.0.1:11434/v1；远端服务必须是 https，
# 明文 http 指向非回环地址会被 config.py 直接拒绝启动（替身会话内容不出本机）。
REASONER_BASE_URL=
REASONER_MODEL=
# 令牌只从环境变量 / .env 读取，绝不写进账本、日志或管理后台回显。
REASONER_API_KEY=
REASONER_TIMEOUT_SECONDS=20.0

# ── Mac Node 桥（严格回环，本机日历落地）──────────────────────────────────────
# 关闭时，创建/改期/取消只生成待确认卡片，不会写入 Mac 日历。
MAC_NODE_ENABLED=0

# 只允许 http://127.0.0.1:18920 或 http://localhost:18920。
# 桥接器随请求携带 Mac Node 令牌，指向非回环地址等于把令牌外送，
# config.py 会抛 ConfigError 拒绝启动（这一条同时是 SSRF 门禁）。
MAC_NODE_URL=http://127.0.0.1:18920
MAC_NODE_TOKEN=
MAC_NODE_TIMEOUT_SECONDS=8.0

# ── A2A 双边加密协商（掩码时段，绝不交换完整日程）────────────────────────────
# 候选时段的掩码密钥：只用于把时间片散列成对端可读的掩码标识，绝不外传原文。
# 留空 = 首次使用时在 <data_dir>/a2a.key 自动生成并 chmod 600。
# 该文件一旦轮换，此前发出的提案将不再与新的掩码标识匹配（旧提案自然过期）。
AGENT_A2A_SECRET=

# ── 零安装访客预约门户（/book/<一次性令牌>）───────────────────────────────────
GUEST_ENABLED=1

# 访客链接的 HMAC 签名密钥。留空 = 首次使用时在 <data_dir>/guest.key 自动生成
# 并 chmod 600（密钥不经管理 API 传输，因此重启后链接仍然有效）。
# 该文件一旦轮换，此前签发的全部访客链接立即失效。
GUEST_SECRET=

# 对外可访问的基础地址，仅用于拼出可复制的访客链接（例如反向代理域名）。
# 留空 = 用 Studio 自身的回环地址；它不会改变监听边界。
GUEST_PUBLIC_BASE_URL=

# 新建访客链接的默认有效期（小时，默认 72）。
GUEST_DEFAULT_TTL_HOURS=72

# 会议链接前缀：写入 .ics 的会议室 URL 由此拼装（例如 https://meet.popopx.im/）。
# 留空 = 访客下载 .ics 时没有会议室链接字段。
AGENT_MEETING_BASE_URL=

# ── 以下变量仅供安装脚本 / docker-compose 读取（app/config.py 忽略）──────────
# GitHub Releases 源（默认 popopx-chat/popopx-chat）；私有仓库请改用只读
# fine-grained token，并通过环境变量而非本文件导出（本文件会进 Studio 进程环境）。
# POPOPX_CLI_REPO=popopx-chat/popopx-chat
# POPOPX_CLI_VERSION=latest          # latest 或具体 tag，如 v7.1.4
# POPOPX_CLI_SHA256=                 # 可选：离线已知的 SHA-256，优先于任何在线来源
# GITHUB_TOKEN=                      # 仅在 CI 里以环境变量传入，不要写进 .env
# POPOPX_UID=1000                    # docker-compose 可选降权
# POPOPX_GID=1000
